{
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "files.associations": {
    "*.html": "html",
    "*.scss": "scss",
    "*.ts": "typescript"
  },

  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "files.exclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.junie/**": true,
    "**/.github/**": true,
    "**/.gemini/**": true,
    "**/.cursor/**": true,
    "**/.claude/**": true,
    "**/.windsurf/**": true,
    "**/.angular/**": true
  }
}
