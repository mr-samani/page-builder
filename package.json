{
  "name": "ngx-page-builder",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve --port=4322 -o",
    "build": "ng build --project=demo",
    "build:sass": "sass projects/ngx-page-builder/designer/assets/style.scss projects/ngx-page-builder/designer/assets/styles.css",
    "build:lib": "npm run build:sass && ng build --project=ngx-page-builder",
    "ng": "ng",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \".//projects//**//*.{ts,html,css,scss}\" ",
    "build:icons": "node scripts/build-icons.js",
    "ngFixImport": "node scripts/fix-shared-imports.js --apply"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@tinymce/tinymce-angular": "^9.1.1",
    "@zumer/snapdom": "^2.0.2",
    "highcharts": "^12.5.0",
    "highcharts-angular": "^5.4.0",
    "msgpack-lite": "^0.1.26",
    "ngx-kit": "^8.2.0",
    "rxjs": "~7.8.0",
    "tinymce": "^8.3.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@babel/parser": "^7.29.0",
    "@types/msgpack-lite": "^0.1.12",
    "glob": "^13.0.1",
    "jsdom": "^27.1.0",
    "minimist": "^1.2.8",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.8.1",
    "recast": "^0.23.11",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
