  "styles": [
    {
      "name": "default",
      "data": "\n@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap');\n\n* {\n    box-sizing: border-box;\n}\n\nhtml {\n    scroll-behavior: smooth;\n}\n\nbody {\n    margin: 0;\n    background: #F7F5F0;\n    color: #24211D;\n    font-family: 'Vazirmatn', sans-serif;\n    direction: rtl;\n}\n\n.taha-page {\n    width: 100%;\n    overflow: hidden;\n    background: #F7F5F0;\n    color: #24211D;\n}\n\n.taha-container {\n    width: min(1160px, calc(100% - 48px));\n    margin: 0 auto;\n}\n\n.taha-header {\n    padding: 22px 0;\n    border-bottom: 1px solid #E4DED3;\n}\n\n.taha-nav {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n}\n\n.taha-logo {\n    color: #9B713B;\n    font-size: 30px;\n    font-weight: 800;\n}\n\n.taha-links {\n    display: flex;\n    gap: 30px;\n    align-items: center;\n}\n\n.taha-links a {\n    color: #777168;\n    text-decoration: none;\n    font-size: 14px;\n}\n\n.taha-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 13px 25px;\n    border-radius: 4px;\n    background: #9B713B;\n    color: #17130D;\n    text-decoration: none;\n    font-weight: 700;\n}\n\n.taha-hero {\n    padding: 105px 0 95px;\n    text-align: center;\n    background:\n        radial-gradient(ellipse at 50% 0%, #EEEAE2, transparent 70%);\n}\n\n.taha-eyebrow {\n    color: #9B713B;\n    font-size: 14px;\n    letter-spacing: 2px;\n    margin-bottom: 20px;\n}\n\n.taha-hero h1 {\n    font-size: clamp(38px, 6vw, 68px);\n    line-height: 1.5;\n    margin: 0 auto 20px;\n    max-width: 850px;\n    font-weight: 800;\n}\n\n.taha-hero p {\n    max-width: 620px;\n    margin: 0 auto 32px;\n    color: #777168;\n    font-size: 16px;\n    line-height: 2.2;\n}\n\n.taha-intro {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    background: #FFFFFF;\n    border: 1px solid #E4DED3;\n    margin-top: -1px;\n}\n\n.taha-intro-item {\n    text-align: center;\n    padding: 28px 15px;\n    border-left: 1px solid #E4DED3;\n}\n\n.taha-intro-item:last-child {\n    border-left: 0;\n}\n\n.taha-intro-item strong {\n    display: block;\n    color: #9B713B;\n    font-size: 24px;\n    margin-bottom: 8px;\n}\n\n.taha-intro-item span {\n    color: #777168;\n    font-size: 13px;\n}\n\n.taha-section {\n    padding: 90px 0;\n}\n\n.taha-section-heading {\n    text-align: center;\n    margin-bottom: 45px;\n}\n\n.taha-section-heading h2 {\n    font-size: 34px;\n    margin: 0 0 12px;\n}\n\n.taha-section-heading p {\n    color: #777168;\n    line-height: 2;\n}\n\n.taha-services {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 18px;\n}\n\n.taha-service {\n    padding: 30px 22px;\n    min-height: 220px;\n    background: #FFFFFF;\n    border: 1px solid #E4DED3;\n    transition: transform .25s, border-color .25s;\n}\n\n.taha-service:hover {\n    transform: translateY(-6px);\n    border-color: #9B713B;\n}\n\n.taha-service-icon {\n    color: #9B713B;\n    font-size: 30px;\n    margin-bottom: 22px;\n}\n\n.taha-service h3 {\n    font-size: 18px;\n    margin: 0 0 12px;\n}\n\n.taha-service p {\n    color: #777168;\n    font-size: 13px;\n    line-height: 2;\n    margin: 0;\n}\n\n.taha-about {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 55px;\n    align-items: center;\n}\n\n.taha-about-visual {\n    min-height: 390px;\n    background:\n        linear-gradient(145deg, #EEEAE2, #FFFFFF);\n    border: 1px solid #E4DED3;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #9B713B;\n    font-size: 38px;\n    font-weight: 800;\n}\n\n.taha-about-copy h2 {\n    font-size: 34px;\n    line-height: 1.7;\n}\n\n.taha-about-copy p {\n    color: #777168;\n    line-height: 2.4;\n}\n\n.taha-gallery {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n}\n\n.taha-gallery-item {\n    min-height: 230px;\n    background: linear-gradient(145deg, #EEEAE2, #FFFFFF);\n    border: 1px solid #E4DED3;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    color: #9B713B;\n    font-size: 20px;\n}\n\n.taha-cta {\n    padding: 65px 30px;\n    text-align: center;\n    background: #FFFFFF;\n    border: 1px solid #E4DED3;\n}\n\n.taha-cta h2 {\n    font-size: 32px;\n    margin: 0 0 15px;\n}\n\n.taha-cta p {\n    color: #777168;\n    margin-bottom: 28px;\n}\n\n.taha-footer {\n    padding: 45px 0;\n    border-top: 1px solid #E4DED3;\n    color: #777168;\n    text-align: center;\n    font-size: 13px;\n}\n\n@media (max-width: 900px) {\n    .taha-services {\n        grid-template-columns: repeat(2, 1fr);\n    }\n\n    .taha-about {\n        grid-template-columns: 1fr;\n    }\n\n    .taha-about-visual {\n        min-height: 280px;\n    }\n}\n\n@media (max-width: 600px) {\n    .taha-container {\n        width: calc(100% - 30px);\n    }\n\n    .taha-links {\n        display: none;\n    }\n\n    .taha-hero {\n        padding: 70px 0;\n    }\n\n    .taha-intro {\n        grid-template-columns: 1fr;\n    }\n\n    .taha-intro-item {\n        border-left: 0;\n        border-bottom: 1px solid #E4DED3;\n    }\n\n    .taha-services {\n        grid-template-columns: 1fr;\n    }\n\n    .taha-gallery {\n        grid-template-columns: 1fr;\n    }\n\n    .taha-section {\n        padding: 65px 0;\n    }\n}\n"
    }
  ],
