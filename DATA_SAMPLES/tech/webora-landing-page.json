      "data": "* { box-sizing:border-box; }\n\nimg { max-width: 100%; }\n\npre { white-space: pre-wrap; font-family: inherit; }\n\nhtml { scroll-behavior: smooth; }\n\nbody { margin: 0px; }\n\n[data-text]::before { content: attr(data-text); }\n\n.nav-link::before { transition: color 0.2s; }\n\n.nav-link:hover::before { color: rgb(255, 255, 255); }\n\n.hero-primary-button { transition: transform 0.2s, box-shadow 0.2s, background 0.2s; }\n\n.hero-secondary-button { transition: transform 0.2s, box-shadow 0.2s, background 0.2s; }\n\n.nav-cta { transition: transform 0.2s, box-shadow 0.2s, background 0.2s; }\n\n.contact-section a { transition: transform 0.2s, box-shadow 0.2s, background 0.2s; }\n\n.hero-primary-button:hover { transform: translateY(-2px); box-shadow: rgba(0, 0, 0, 0.133) 0px 10px 25px; }\n\n.nav-cta:hover { transform: translateY(-2px); box-shadow: rgba(0, 0, 0, 0.133) 0px 10px 25px; }\n\n.contact-section a:hover { transform: translateY(-2px); box-shadow: rgba(0, 0, 0, 0.133) 0px 10px 25px; }\n\n.hero-secondary-button:hover { border-color: rgb(91, 124, 250); background: rgb(21, 30, 56); }\n\n.service-card { transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }\n\n.service-card:hover { transform: translateY(-5px); box-shadow: rgba(16, 24, 40, 0.07) 0px 18px 45px; border-color: rgb(215, 222, 240); }\n\n@media (max-width:700px) .hero-nav .nav-links { display:none; }\n\n@media (max-width:700px) .hero-title { font-size:43px !important;letter-spacing:-2px !important; }\n\n@media (max-width:700px) .hero-description { font-size:16px !important; }\n\n@media (max-width:700px) .hero-actions { flex-direction:column;align-items:stretch; }\n\n@media (max-width:700px) .hero-actions a { width:100%; }\n\n@media (max-width:700px) .hero-stats { gap:25px !important;flex-wrap:wrap; }\n\n@media (max-width:700px) .hero-stats .stat { min-width:110px !important; }\n\n@media (max-width:700px) .services-title { font-size:31px !important; }\n\n@media (max-width:700px) .process-heading h2 { font-size:31px !important; }\n\n@media (max-width:700px) .contact-title { font-size:36px !important; }"
